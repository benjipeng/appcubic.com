---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StudioObject from '../components/StudioObject.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="About AppCubic | An independent applied AI studio"
  description="AppCubic connects model capability, research, and product engineering. Meet the independent studio behind App Automaton and its public tools."
  pathname="/about/"
>
  <Nav />
  <main id="main" class="about-page">
    <section class="about-hero">
      <span class="eyebrow">The studio / Since 2019</span>
      <h1>
        A small studio.
        <br />A wide field
        <br />
        of <em>possibility.</em>
      </h1>
      <StudioObject class="about-object" />
      <p>
        AppCubic is an independent applied AI venture studio. We build agentic systems, turn
        research into working products, and advise technical teams.
      </p>
    </section>
    <section class="about-story">
      <span class="eyebrow">Close to the work</span>
      <div>
        <h2>
          Curiosity,
          <br />
          with a practical side.
        </h2>
        <p>
          AppCubic began in 2019 as a hands-on building practice. The work has grown across
          e-commerce, logistics, decision support, camera-based motion understanding, and scientific
          computing.
        </p>
        <p>
          We stay close to implementation. That means understanding data and retrieval, making tool
          boundaries explicit, evaluating what a system actually does, and shaping interfaces people
          can work with.
        </p>
        <p>
          It also means knowing where judgment matters. Good automation leaves people with useful
          control and results they can inspect.
        </p>
      </div>
    </section>
    <section class="about-open" data-dark-scene>
      <span class="eyebrow">Built in public</span>
      <h2>
        An open workshop
        <br />
        for <em>better tools.</em>
      </h2>
      <p>
        <a href={site.links.appautomatonSite}>App Automaton</a> brings together the studio's public
        agent tools, local inference work, and creative systems. Explore each project's source and
        documentation for its license and model terms.
      </p>
      <a class="pill-action" href={site.links.appautomatonSite}>
        Explore the public work <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section class="about-story">
      <span class="eyebrow">People and perspective</span>
      <div>
        <h2>
          Independent thinking.
          <br />
          Shared possibilities.
        </h2>
        <p>
          Product strategy, technical diligence, research workflows, and the craft of building
          systems are part of the same practice. We work from the problem outward, with enough care
          to make the result useful.
        </p>
        <p>
          Research systems live at <a href={site.links.research}>research.appcubic.com</a>. Product
          and operations work connects through <a href={site.links.futur}>Futur</a>. Technical
          writing on machine learning, systems, and security is collected at{' '}
          <a href={site.links.renocrypt}>RenoCrypt</a>.
        </p>
        <a class="text-action" href={site.links.benji}>
          More about Benji <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
