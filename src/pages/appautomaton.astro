---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { projectCount, selectedGroups } from '../data/workshop';
import room from '../assets/art/open-assembly.webp';
const description =
  'App Automaton is AppCubic’s public workshop for coding agents, local intelligence, and creative tools. Explore selected projects and their original sources.';
---

<BaseLayout
  title="App Automaton | The public workshop of AppCubic"
  description={description}
  pathname="/appautomaton/"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': 'https://appautomaton.com/#org',
      name: 'App Automaton',
      url: site.links.appautomatonSite,
      parentOrganization: { '@id': site.url + '/#organization' },
      sameAs: [site.links.appautomatonOrg, 'https://huggingface.co/appautomaton'],
    })}
  ></script>
  <Nav />
  <main id="main" class="workshop-page">
    <section class="workshop-hero">
      <span class="eyebrow">App Automaton / An AppCubic workshop</span>
      <h1>
        Made in public.
        <br />
        Yours to <em>explore.</em>
      </h1>
      <div class="workshop-intro">
        <p>
          Our public work connects coding agents with useful workflows, brings models onto local
          hardware, and gives creative practice room to develop. Each project starts with something
          worth making.
        </p>
        <a class="text-action" href={site.links.appautomatonSite}>
          Explore all {projectCount} projects <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <div class="workshop-image">
      <img src={room.src} width="1100" height="1100" alt="" decoding="async" />
      <span>
        Ideas become more useful
        <br />
        when people can work with them.
      </span>
    </div>
    {selectedGroups.map((group, index) => (
      <section class={`workshop-group group-${group.key}`} aria-labelledby={`group-${group.key}`}>
        <div class="workshop-group-heading">
          <span class="eyebrow">
            0{index + 1} / {group.label}
          </span>
          <h2 id={`group-${group.key}`} data-reveal>
            {group.title}
          </h2>
        </div>
        <div class="workshop-projects">
          {group.projects.map((p) => (
            <article>
              <h3>
                <a href={p.url}>
                  {p.repo} <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{p.description}</p>
              {p.site && (
                <a class="source-link" href={p.source}>
                  GitHub source<span class="sr-only"> for {p.repo}</span>{' '}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
    <section class="workshop-ending">
      <h2>
        Follow the idea
        <br />
        <em>a little further.</em>
      </h2>
      <p>
        The complete catalog is maintained at appautomaton.com. Project websites, source
        repositories, and documentation are collected there as the work evolves.
      </p>
      <a class="pill-action" href={site.links.appautomatonSite}>
        The complete collection <span aria-hidden="true">↗</span>
      </a>
      <p>
        <a class="text-action" href={site.links.appautomatonOrg}>
          Browse the GitHub organization <span aria-hidden="true">↗</span>
        </a>
      </p>
      <p class="license-note">
        Code and model terms vary by project. Read the source repository and model documentation
        before use.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
