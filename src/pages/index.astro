---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StudioObject from '../components/StudioObject.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import room from '../assets/art/open-assembly.webp';
import researchArt from '../assets/art/discrete-matter.webp';
import creativeArt from '../assets/art/signal-weave.webp';
import { site } from '../data/site';
import { project, projectCount } from '../data/workshop';
const atomistic = project('mlx-atomistic');
const setloom = project('setloom');
---

<BaseLayout>
  <Nav />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title" data-hero>
      <div class="hero-topline">
        <span class="eyebrow">Independent applied AI studio</span>
        <span class="eyebrow">Established 2019</span>
      </div>
      <div class="hero-copy">
        <h1 id="hero-title">
          Intelligence,
          <br />
          put to <em>work.</em>
        </h1>
        <p>
          We turn ideas into working systems.
          <br />
          Agent workflows, research tools, and products
          <br class="desktop-break" /> built with care for the people using them.
        </p>
        <a class="text-action" href="#work">
          Explore the work <span aria-hidden="true">↘</span>
        </a>
      </div>
      <StudioObject eager class="hero-object" />
      <div class="hero-monument" aria-hidden="true">
        <span>AppCubic.</span>
      </div>
      <div class="hero-baseline" aria-hidden="true">
        <span></span>
      </div>
    </section>
    <div class="hero-hold" aria-hidden="true"></div>
    <section class="feature-track" id="work" aria-labelledby="workshop-title">
      <div class="feature-stage" data-dark-scene>
        <div class="feature-window">
          <img
            class="feature-image"
            src={room.src}
            width="1100"
            height="1100"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="feature-shade"></div>
        </div>
        <div class="feature-top">
          <span class="eyebrow">Selected work / 01</span>
          <span class="case-pill">App Automaton</span>
        </div>
        <div class="feature-copy">
          <h2 id="workshop-title">
            A useful idea.
            <br />
            An open <em>possibility.</em>
          </h2>
          <p>
            Our public workshop brings together tools for coding agents, local intelligence, and
            creative work. Each project offers a practical way to carry an idea further.
          </p>
          <a class="pill-action" href={site.links.appautomatonSite}>
            Explore App Automaton <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="feature-bottom">
          <span>
            {projectCount} public projects.
            <br />
            Source available. Possibilities shared.
          </span>
          <a href="/appautomaton/">
            Inside the workshop <span aria-hidden="true">↗</span>
          </a>
        </div>
        <span class="feature-number" aria-hidden="true">
          01
        </span>
      </div>
    </section>
    <section class="selected-work" aria-labelledby="selected-title">
      <div class="section-head">
        <span class="eyebrow">Different questions. The same care.</span>
        <h2 id="selected-title" data-reveal>
          Work takes
          <br />
          <em>many forms.</em>
        </h2>
      </div>
      <div class="case-pair">
        <article class="project-study study-research" data-reveal>
          <a class="study-link" href={atomistic.url}>
            <div class="study-art">
              <span class="eyebrow">02 / Research into practice</span>
              <img
                src={researchArt.src}
                width="1100"
                height="1100"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="study-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
            <h3>
              Scientific computing,
              <br />
              <em>closer to home.</em>
            </h3>
          </a>
          <div class="study-details">
            <span>MLX Atomistic</span>
            <p>
              Molecular dynamics and density functional theory on Apple silicon. An inspectable path
              from scientific methods to a runtime on the Mac.
            </p>
          </div>
        </article>
        <article class="project-study study-creative" data-reveal>
          <a class="study-link" href={setloom.url}>
            <div class="study-art">
              <span class="eyebrow">03 / Creative systems</span>
              <img
                src={creativeArt.src}
                width="1100"
                height="1100"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="study-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
            <h3>
              Tools that leave
              <br />
              <em>room for taste.</em>
            </h3>
          </a>
          <div class="study-details">
            <span>Setloom</span>
            <p>
              A working environment for music, with editable sessions, stems, and listening notes.
              The process has structure. The creative judgment stays human.
            </p>
          </div>
        </article>
      </div>
      <div class="work-afterword">
        <p>
          Selected from the studio's public work.
          <br />
          Each project has its own source, documentation, and license terms.
        </p>
        <a class="text-action" href={site.links.appautomatonSite}>
          See the complete collection <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="practice" id="practice" aria-labelledby="practice-title" data-dark-scene>
      <div class="practice-heading">
        <span class="eyebrow">The practice</span>
        <h2 id="practice-title" data-reveal>
          Good systems
          <br />
          make room for
          <br />
          <em>human judgment.</em>
        </h2>
      </div>
      <div class="practice-copy">
        <p class="lead">
          Applied AI becomes useful when it fits the work around it. We connect model capability
          with clear interfaces, careful evaluation, and the realities of running a product.
        </p>
        <a class="text-action" href="/about/">
          A closer look at the studio <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="practice-steps">
        <article data-reveal>
          <span class="eyebrow">01 / Understand</span>
          <h3>
            Find the right
            <br />
            question.
          </h3>
          <p>
            Frame the problem, examine the constraints, and make the important decisions explicit.
          </p>
        </article>
        <article data-reveal>
          <span class="eyebrow">02 / Build</span>
          <h3>
            Give the idea
            <br />a working form.
          </h3>
          <p>
            Connect models, tools, data, and interfaces into a system people can inspect and use.
          </p>
        </article>
        <article data-reveal>
          <span class="eyebrow">03 / Refine</span>
          <h3>
            Learn from
            <br />
            the actual work.
          </h3>
          <p>
            Evaluate behavior, improve the weak points, and leave a clear path for the next
            iteration.
          </p>
        </article>
      </div>
    </section>
    <section class="studio-links" aria-labelledby="elsewhere-title">
      <span class="eyebrow">A little further</span>
      <h2 id="elsewhere-title">Curiosity travels.</h2>
      <a href={site.links.research}>
        <span>Research systems</span>
        <span class="studio-link-note">Methods, experiments, and technical work</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={site.links.renocrypt}>
        <span>RenoCrypt</span>
        <span class="studio-link-note">Writing on machine learning, systems, and security</span>
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
  <Footer />
</BaseLayout>
